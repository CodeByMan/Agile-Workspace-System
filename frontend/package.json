{
  "name": "agile-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:unit && npm run test:policy",
    "start:https-api": "ng serve --proxy-config proxy.https.conf.json",
    "test:ci": "npm test",
    "test:unit": "ng test --no-watch --no-progress",
    "test:policy": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"tests/**/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"tests/**/*.ts\" \"*.json\""
  },
  "dependencies": {
    "@angular/common": "21.2.18",
    "@angular/compiler": "21.2.18",
    "@angular/core": "21.2.18",
    "@angular/forms": "21.2.18",
    "@angular/platform-browser": "21.2.18",
    "@angular/router": "21.2.18",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.19",
    "@angular/cli": "21.2.19",
    "@angular/compiler-cli": "21.2.18",
    "@types/node": "^24.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0",
    "npm": ">=10"
  }
}

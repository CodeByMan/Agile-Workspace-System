# Copy this file to .env for local Docker use. Never commit .env.
# Use long, unique values. These examples are intentionally non-deployable placeholders.
MSSQL_SA_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_SQL_PASSWORD
JWT_SIGNING_KEY=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES
JWT_LIFETIME_MINUTES=60
GITHUB_PERSONAL_ACCESS_TOKEN=
AUDIT_LOG_RETENTION_DAYS=30
AUDIT_LOG_CLEANUP_INTERVAL_HOURS=24
